# =======================================================
# ClipFlow / YT-Auto .gitignore
# =======================================================

# --- Environment & Secrets ---
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
atlas-credentials.env
backend/atlas-credentials.env
cookies.txt
backend/cookies.txt
qt-app/cookies.txt
*.pem
*.key

# --- Antigravity IDE & Editor Cache ---
.antigravity
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Python & Cache Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.venv/
env/
venv/
ENV/

# --- Qt App Build & Distribution Artifacts ---
qt-app/dist/
qt-app/build/
qt-app/build_installer/
qt-app/build_pyi/
qt-app/bin/*.exe
qt-app/bin/*.dll
qt-app/*.spec.bak
qt-app/logs/
qt-app/jobs/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Dependencies ---
node_modules/
backend/node_modules/
frontend/node_modules/

# --- Web App Build Outputs ---
dist/
dist-ssr/
build/
backend/dist/
frontend/dist/
frontend/dist-ssr/
*.local

# --- Media, Temp Dumps, & Transcodes ---
temp/
backend/temp/
backend/temp/**
backend/data/
backend/public/downloads/*
!backend/public/downloads/.gitkeep
*.part
*.mp4
*.m4a
*.webm
*.mkv
*.ts

# --- Binaries, Toolchains, & Installers ---
*.exe
*.zip
*.tar.gz
*.dmg
inno_setup.exe
yt-dlp
yt-dlp.exe
backend/yt-dlp.exe
backend/yt-dlp_new.exe
backend/ffmpeg.exe
backend/ffplay.exe
backend/ffprobe.exe
backend/download dlp.zip
FFmpeg
FFmpeg/
release/

# --- Scratch & Platform Specific Dumps ---
.twitch
.twitch/
available_domains.json
available_domains.txt
backend/dqw_info.json
backend/app-version.json
test.js
test2.ts
test_com.py