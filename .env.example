# Backend Configuration Reference
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/clipflow?retryWrites=true&w=majority

# Security Secrets (32+ characters)
SESSION_SECRET=your_super_secret_session_key_at_least_32_bytes_long
ENCRYPTION_KEY=your_application_level_32_byte_secret_key_here!

# Google Master Drive Storage
GOOGLE_MASTER_CLIENT_ID=
GOOGLE_MASTER_CLIENT_SECRET=
GOOGLE_MASTER_REFRESH_TOKEN=
GOOGLE_MASTER_ROOT_FOLDER_NAME=ClipFlow

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
